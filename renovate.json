{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Family presets from plurano/horistes (Horistes is Greek for the boundary commissioner who fixes limits, pronounced ho-RIS-tees): default.json for every repository of the family, settings-sync.json because rust-toolchain.toml is held to settings-source.json by the gate."
  ],
  "extends": [
    "github>plurano/horistes",
    "github>plurano/horistes:settings-sync"
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/^tools/semgrep/requirements\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/praetor-docs.yml",
        "tools/markdownlint/package.json",
        "tools/markdownlint/package-lock.json",
        "tools/markdownlint/markdownlint-cli2.yaml",
        "tools/markdownlint/verify.mjs",
        "tools/markdownlint/no-private-scratch-links.mjs",
        "tools/figures/core.mjs",
        "tools/figures/checks.mjs",
        "tools/figures/build.mjs",
        "tools/figures/types.ts",
        "tools/figures/third_party/interfig/vendor.json",
        "tools/figures/third_party/interfig/VENDOR.md",
        "tools/figures/third_party/interfig/upstream/LICENSE",
        "tools/figures/third_party/interfig/upstream/src/svg.ts",
        "tools/figures/third_party/interfig/upstream/src/geometry.ts",
        "tools/figures/third_party/interfig/upstream/src/model.ts",
        "tools/figures/figures.css",
        "tools/figures/mkdocs_hook.py",
        "tools/figures/astro.mjs",
        "tools/figures/serve.mjs",
        "tools/figures/eslint.figures.mjs",
        "tools/figures/README.md",
        ".github/workflows/praetor-api.yml",
        "tools/apicompat/gate/main.go",
        "tools/apicompat/gate/placeholder.go",
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor",
        ".config/reuse/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "Trivy vulnerability database update schedule",
      "matchDepNames": [
        "ghcr.io/aquasecurity/trivy-db"
      ],
      "schedule": [
        "before 4am on monday"
      ]
    },
    {
      "description": "The semgrep lock moves only by re-running the uv pip compile command in its header (pip-compile manager); bumping one pin of it alone breaks the bounds of the others",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "tools/semgrep/requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "Python 3.14 is the newest Python version semgrep 1.181.0 lists and the lock in tools/semgrep/requirements.txt is compiled for one Python version; raise allowedVersions when semgrep lists a newer Python, together with a relock",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<=3.14"
    },
    {
      "description": "praetor-managed engine: updates arrive in one coordinated adoption pull request",
      "matchPackageNames": [
        "github.com/cordanaLLM/praetor",
        "github.com/cordanaLLM/praetor/**",
        "github.com/cordanaLLM/praetor/cmd/standardsctl",
        "cordanaLLM/praetor",
        "cordanaLLM/praetor/**"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Trivy vulnerability database pinned by digest",
      "managerFilePatterns": [
        "/^tools/scanners\\.py$/"
      ],
      "matchStrings": [
        "TRIVY_DB_DIGEST = \"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "ghcr.io/aquasecurity/trivy-db",
      "datasourceTemplate": "docker",
      "currentValueTemplate": "2"
    },
    {
      "currentValueTemplate": "HEAD",
      "customType": "regex",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "praetor-workflow-engine-pin",
      "description": "praetor workflow engine commit pin: track the engine default branch",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?m)^[\\t ]*(PRAETOR_COMMIT)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-f]{40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$",
        "(?m)^[\\t ]*(PRAETOR_REF)[\\t ]*[:=][\\t ]*[\"']?(?<currentDigest>[0-9a-fA-F]{7,40})[\"']?[\\t ]*(#[^\\r\\n]*)?\\r?$"
      ],
      "packageNameTemplate": "https://github.com/cordanaLLM/praetor"
    }
  ]
}
